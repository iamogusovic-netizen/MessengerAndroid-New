@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{color-scheme:dark;--bg:#0b1020;--panel:#11182a;--panel2:#161f33;--line:#263149;--text:#edf2ff;--muted:#8f9bb4;--accent:#8b7bff;--accent2:#6555e8;--bubble:#182238;--mine:#5549bd;--green:#45d6a0;--danger:#ff7d8a;--shadow:0 24px 70px #02061766}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font-family:'DM Sans',system-ui,sans-serif}button,input,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.hidden{display:none!important}.muted{color:var(--muted)}.tiny{font-size:11px;line-height:1.6}.auth-screen{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(ellipse at 50% 15%,#3d347b55,transparent 48%),var(--bg)}.auth-card{width:min(100%,420px);padding:38px;background:#11182aee;border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.brand-mark{width:52px;height:52px;display:grid;place-items:center;border-radius:17px;background:linear-gradient(135deg,#9e90ff,#6354e7);color:white;font:800 30px Manrope,sans-serif;box-shadow:0 10px 30px #7465ff44}.brand-mark.small{width:34px;height:34px;border-radius:11px;font-size:21px}.eyebrow{margin:24px 0 6px;color:#a99fff;font-size:10px;font-weight:700;letter-spacing:2.2px}.auth-card h1{font:800 31px Manrope,sans-serif;margin:0}.auth-copy{font-size:13px;margin:10px 0 24px}.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;background:#0b1020;border-radius:11px;margin-bottom:22px}.tab{border:0;border-radius:8px;padding:10px;color:var(--muted);background:transparent;font-size:12px;font-weight:600}.tab.active{background:#252e46;color:var(--text)}.auth-form label{display:block;font-size:12px;font-weight:600;margin:15px 0 7px}.auth-form input{display:block;width:100%;margin-top:8px;background:#0c1323;border:1px solid #2c3853;border-radius:10px;padding:13px;color:var(--text);outline:none}.auth-form input:focus{border-color:var(--accent)}.field-hint{margin:-2px 0 10px;color:var(--muted);font-size:10px}.primary{border:0;background:linear-gradient(135deg,#9485ff,#6b5be7);color:white;border-radius:10px;padding:13px 18px;font-weight:700;box-shadow:0 8px 24px #6b5be733}.primary.full{width:100%;margin-top:12px}.primary:disabled{opacity:.55;cursor:wait}.error{min-height:18px;color:var(--danger);font-size:12px;margin:8px 0}.auth-card .tiny{margin:18px 0 0}.app-shell{height:100vh;min-height:550px;display:grid;grid-template-columns:280px minmax(0,1fr);max-width:1600px;margin:0 auto;background:var(--panel)}.sidebar{display:flex;flex-direction:column;min-width:0;border-right:1px solid var(--line);background:#0f1627}.side-header{height:74px;padding:0 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand-lockup{display:flex;align-items:center;gap:10px;font:800 14px Manrope,sans-serif;letter-spacing:-.3px}.icon-button{width:34px;height:34px;display:grid;place-items:center;border:1px solid transparent;border-radius:10px;background:transparent;color:var(--muted);font-size:19px}.icon-button:hover{background:var(--panel2);color:var(--text)}.profile-row{display:flex;align-items:center;gap:10px;padding:18px 17px 20px}.avatar{flex-shrink:0;width:38px;height:38px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,#7162e8,#c18dff);color:white;font-weight:700}.profile-info{display:flex;flex:1;min-width:0;flex-direction:column;gap:5px}.profile-info strong{font-size:12px;overflow:hidden;text-overflow:ellipsis}.online-label{font-size:10px;color:var(--muted)}.online-label i,.status-dot{display:inline-block;width:6px;height:6px;background:var(--green);border-radius:50%;margin-right:5px}.side-section-title,.contacts-heading{padding:8px 20px;color:#77839d;font-size:9px;font-weight:700;letter-spacing:1.4px}.conversation{width:calc(100% - 20px);margin:0 10px;display:flex;align-items:center;gap:11px;padding:11px 10px;border:0;border-radius:11px;background:transparent;text-align:left;color:var(--text)}.conversation.active,.conversation:hover{background:#242541}.conversation-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:#38315f;color:#b6adff;font-size:21px}.conversation-copy{display:flex;flex-direction:column;gap:4px}.conversation-copy strong{font-size:12px}.conversation-copy small{font-size:10px;color:var(--muted)}.contacts-heading{display:flex;justify-content:space-between;align-items:center;margin-top:23px}.contacts-heading span:last-child{padding:2px 7px;border-radius:6px;background:#202a40;letter-spacing:0}.contacts-list{overflow:auto;padding:4px 10px}.contact{display:flex;align-items:center;gap:10px;width:100%;padding:9px 10px;margin:2px 0;border:0;border-radius:10px;background:transparent;color:var(--text);text-align:left}.contact:hover,.contact.active{background:#202a40}.contact .avatar{width:33px;height:33px;border-radius:11px;font-size:12px}.contact-copy{min-width:0;flex:1;display:flex;flex-direction:column;gap:4px}.contact-copy strong{font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.contact-copy small{font-size:10px;color:var(--muted)}.presence-dot{width:7px;height:7px;border-radius:50%;background:#58637a}.presence-dot.online{background:var(--green);box-shadow:0 0 0 3px #45d6a015}.empty-contacts{padding:15px 10px;font-size:11px;color:var(--muted);line-height:1.6}.sidebar-footer{margin-top:auto;border-top:1px solid var(--line);padding:17px 19px;font-size:9px;color:var(--muted)}.chat-panel{display:flex;flex-direction:column;min-width:0;background:var(--panel)}.chat-header{height:74px;flex-shrink:0;display:flex;align-items:center;gap:13px;padding:0 28px;border-bottom:1px solid var(--line)}.chat-avatar{width:40px;height:40px;border-radius:13px;background:#28274a;color:#b6adff}.chat-title{min-width:0;flex:1}.chat-title h2{font:700 14px Manrope,sans-serif;margin:0 0 5px}.chat-title p{font-size:10px;color:var(--muted);margin:0}.header-right{display:flex;align-items:center;gap:13px}.connection{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--muted)}.connection i{width:6px;height:6px;border-radius:50%;background:#f0bd68}.connection i.connected{background:var(--green)}.messages{flex:1;overflow:auto;padding:26px clamp(18px,5vw,70px);display:flex;flex-direction:column;gap:16px}.welcome{margin:auto;text-align:center;max-width:300px;color:var(--muted)}.welcome-symbol{width:54px;height:54px;margin:0 auto 16px;display:grid;place-items:center;border-radius:18px;background:#242342;color:#aaa0ff;font-size:25px}.welcome h3{color:var(--text);font:700 16px Manrope,sans-serif;margin:0 0 8px}.welcome p{font-size:12px;line-height:1.7}.message{max-width:min(78%,620px);display:flex;flex-direction:column;gap:6px;align-self:flex-start;animation:appear .16s ease-out}.message.mine{align-self:flex-end}.message-meta{display:flex;align-items:center;gap:8px;padding:0 4px;font-size:10px;color:var(--muted)}.message.mine .message-meta{justify-content:flex-end}.message-meta strong{color:#c4bcff;font-weight:600}.message-bubble{white-space:pre-wrap;overflow-wrap:anywhere;padding:11px 14px;border:1px solid #2a3650;border-radius:4px 15px 15px 15px;background:var(--bubble);font-size:12px;line-height:1.65}.message.mine .message-bubble{border-color:#6659c4;border-radius:15px 4px 15px 15px;background:var(--mine)}.message.private .message-meta:after{content:'ЛИЧНО';font-size:8px;letter-spacing:.8px;color:#b2aaff;background:#302c56;padding:3px 5px;border-radius:4px}.typing-indicator{height:18px;padding:0 clamp(18px,5vw,70px);font-size:10px;color:var(--muted)}.composer{position:relative;display:flex;align-items:flex-end;gap:10px;margin:0 28px;padding:12px 12px 25px;background:#0e1525;border:1px solid #29354f;border-radius:15px}.composer textarea{flex:1;min-width:0;max-height:140px;resize:none;border:0;outline:0;background:transparent;color:var(--text);padding:7px 2px;font-size:12px;line-height:1.6}.composer textarea::placeholder{color:#6e7a94}.emoji-button{width:32px;height:34px;flex-shrink:0;border:0;background:transparent;color:#929db4;font-size:22px}.send-button{width:36px;height:36px;flex-shrink:0;border:0;border-radius:11px;background:linear-gradient(135deg,#9384ff,#6958e7);color:white;font-size:17px}.composer-hint{position:absolute;left:55px;bottom:7px;color:#65718b;font-size:9px}.footer-note{text-align:center;color:#66728a;font-size:9px;padding:10px 10px 13px}.light{color-scheme:light;--bg:#edf0f8;--panel:#fff;--panel2:#f1f3fa;--line:#e0e4ef;--text:#20263a;--muted:#7c849a;--bubble:#f1f3fb;--mine:#6d5be8}.light .sidebar{background:#f8f9fd}.light .auth-card{background:#fff}.light .auth-form input,.light .auth-tabs,.light .composer{background:#f7f8fc}.light .message-bubble{border-color:#e1e5f0}.light .message.mine .message-bubble{background:#6d5be8;color:#fff}.light .side-header{background:#f8f9fd}.light .conversation.active,.light .conversation:hover,.light .contact:hover,.light .contact.active{background:#eceefa}.light .profile-row .icon-button:hover,.light .icon-button:hover{background:#e8eaf5}.light .auth-form input{color:var(--text)}
@keyframes appear{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:720px){.app-shell{grid-template-columns:76px minmax(0,1fr)}.side-header{justify-content:center;padding:0}.brand-lockup span,.side-header>.icon-button,.profile-info,.profile-row>#logoutButton,.side-section-title,.conversation-copy,.contacts-heading,.contact-copy,.sidebar-footer{display:none}.profile-row{justify-content:center;padding:16px 0}.conversation{width:54px;height:54px;justify-content:center;padding:0;margin:0 auto}.conversation-icon{width:38px;height:38px}.contacts-list{padding:5px 7px}.contact{justify-content:center;padding:8px 0}.contact .avatar{width:38px;height:38px}.chat-header{padding:0 15px;gap:9px}.header-right{gap:5px}.connection span{display:none}.messages{padding:20px 14px}.message{max-width:90%}.composer{margin:0 10px;padding:9px 8px 24px;gap:5px}.composer-hint{left:48px;font-size:8px}.footer-note{font-size:8px}.auth-card{padding:28px 23px}}@media(max-width:420px){.app-shell{grid-template-columns:60px minmax(0,1fr)}.conversation{width:48px}.contact .avatar{width:34px;height:34px}.chat-title h2{font-size:12px}.chat-title p{font-size:9px}.chat-avatar{width:34px;height:34px}.chat-header{padding:0 9px}.header-right .icon-button{width:28px}.connection{display:none}.message-bubble{font-size:11px;padding:9px 11px}}

.search-label{display:block;padding:0 12px 8px}.search-label input{width:100%;min-width:0;padding:10px 11px;border:1px solid var(--line);border-radius:9px;background:#0c1323;color:var(--text);font-size:11px}.search-label input::placeholder{color:var(--muted)}.light .search-label input{background:#f7f8fc;color:var(--text)}@media(max-width:720px){.search-label{padding:4px 7px}.search-label input{padding:8px 3px;font-size:0}.search-label input:focus{font-size:10px}.search-label input::placeholder{color:transparent}}
